# 通知設定1組の雛形。必要な数だけコピーして、それぞれ独立して設定してください。
# このファイルの値は、起動用 .env や他の通知設定から継承しません。

# Discord の Webhook URL（この通知設定の送信先・必須）
# サーバー設定 → 連携サービス → ウェブフック で発行
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# このWebhookの通知で強調表示する地点（任意、JSON配列、件数の固定上限なし）
# pref=都道府県（北海道の予報区は北海道）、name=情報源の地域・観測点名と完全一致、label=任意の表示名
# 情報源に震度が含まれる地点のみ表示します。通知のしきい値は変わりません。
#WATCHED_POINTS='[{"pref":"東京都","name":"東京都23区","label":"自宅周辺"},{"pref":"神奈川県","name":"神奈川県東部","label":"職場周辺"}]'

# 通知のしきい値（任意・スケール値で指定）
#   10=震度1 20=2 30=3 40=4 45=5弱 50=5強 55=6弱 60=6強 70=7
# 地震情報(551)の観測震度・緊急地震速報(556)の予想震度の両方に適用されます。
#
# 下限が未設定の地方・地域で通知する最小震度（既定 50 = 震度5強）
OTHER_MIN_SCALE=50
# 地方ごとに下限を設定できます。設定しない地方は OTHER_MIN_SCALE にフォールバックします。
# 低い下限で通知したい地方のコメントを外して設定してください（例: 震度4=40）。
#HOKKAIDO_MIN_SCALE=40
#TOHOKU_MIN_SCALE=40
#KANTO_MIN_SCALE=40
#CHUBU_MIN_SCALE=40
#KINKI_MIN_SCALE=40
#CHUGOKU_MIN_SCALE=40
#SHIKOKU_MIN_SCALE=40
#KYUSHU_MIN_SCALE=40

# 地図画像を添付するか（true/false、既定 true）
ATTACH_MAP=true

# 地図タイルの URL テンプレート（任意）
# 既定は国土地理院の白地図(blank、日本全国・zoom 5〜14)。
# 利用時は出典「地理院タイル」の表示が必要です（本botは通知に出典を明記します）。
#   https://maps.gsi.go.jp/development/ichiran.html
# OpenStreetMap に戻す場合は次を指定: https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_URL_TEMPLATE=https://cyberjapandata.gsi.go.jp/xyz/blank/{z}/{x}/{y}.png
