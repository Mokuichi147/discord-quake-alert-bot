# 構造化された通知設定は config.toml に記述します。
# ここにはWebhook URLなどの秘密値だけを置きます。

# config.toml の [webhooks.main] が参照する環境変数
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# config.toml に追加のWebhookを登録した場合の例
#DISCORD_WEBHOOK_HOME=https://discord.com/api/webhooks/aaaaaaaa/bbbbbbbb
#DISCORD_WEBHOOK_OFFICE=https://discord.com/api/webhooks/cccccccc/dddddddd

# WebSocket接続先をTOMLで指定しない場合だけ使用（任意）
#P2PQUAKE_WS_URL=wss://api.p2pquake.net/v2/ws

# ログレベル（任意）
RUST_LOG=info

# 設定ファイルを config.toml 以外にする場合（任意）
#QUAKE_ALERT_CONFIG=/opt/quake-alert-bot/config.toml
