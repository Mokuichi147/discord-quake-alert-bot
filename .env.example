# Discord の Webhook URL（単一送信先の場合に必須）
# サーバー設定 → 連携サービス → ウェブフック で発行
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# このWebhookの通知で強調表示する地点（任意、JSON配列、件数の固定上限なし）
# pref=都道府県、name=情報源の地域・観測点名と完全一致、label=任意の表示名
# 情報源に震度が含まれる地点のみ表示します。通知のしきい値は変わりません。
# 以下は2026/09/07 23:21の地震について、公開APIの points.addr で確認した実在の名称です。
# 「熊本県天草・芦北」は震度速報の地域名、「上天草市大矢野町」は詳報の観測点名です。
# 地域名と観測点名は別々に照合するため、必要に応じて両方を登録してください。
# 確認元: https://api.p2pquake.net/v2/history?codes=551&limit=10
#WATCHED_POINTS='[{"pref":"熊本県","name":"熊本県天草・芦北","label":"注目地域"},{"pref":"熊本県","name":"上天草市大矢野町","label":"注目観測点"}]'

# 通知のしきい値（任意・スケール値で指定）
#   10=震度1 20=2 30=3 40=4 45=5弱 50=5強 55=6弱 60=6強 70=7
# 地震情報(551)の観測震度・緊急地震速報(556)の予想震度の両方に適用されます。
#
# 下限が未設定の地方・地域で通知する最小震度（既定 50 = 震度5強）
OTHER_MIN_SCALE=50
# 地方ごとに下限を設定できます。設定しない地方は OTHER_MIN_SCALE にフォールバックします。
# 低い下限で通知したい地方のコメントを外して設定してください（例: 震度4=40）。
#HOKKAIDO_MIN_SCALE=40
#TOHOKU_MIN_SCALE=40
#KANTO_MIN_SCALE=40
#CHUBU_MIN_SCALE=40
#KINKI_MIN_SCALE=40
#CHUGOKU_MIN_SCALE=40
#SHIKOKU_MIN_SCALE=40
#KYUSHU_MIN_SCALE=40

# 地図画像を添付するか（true/false、既定 true）
ATTACH_MAP=true

# 地図タイルの URL テンプレート（任意）
# 既定は国土地理院の白地図(blank、日本全国・zoom 5〜14)。
# 利用時は出典「地理院タイル」の表示が必要です（本botは通知に出典を明記します）。
#   https://maps.gsi.go.jp/development/ichiran.html
# OpenStreetMap に戻す場合は次を指定: https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_URL_TEMPLATE=https://cyberjapandata.gsi.go.jp/xyz/blank/{z}/{x}/{y}.png

# WebSocket エンドポイント（任意・通常変更不要）
P2PQUAKE_WS_URL=wss://api.p2pquake.net/v2/ws

# ログレベル（任意）
RUST_LOG=info

# 従来の通知設定を複数使う場合（任意）
# .env.notification.example を必要な数だけ複製し、各ファイルに
# DISCORD_WEBHOOK_URL・OTHER_MIN_SCALE・各地方のしきい値・地図設定を記述します。
# 地域名などの接頭辞は不要です。通知設定一式を独立して複数持てます。
# 以下を指定した場合、上の通知設定は使わず、各ファイルだけから読み込みます。
# 相対パスは起動時の作業ディレクトリ基準。1プロセス・1接続で全設定を処理します。
#NOTIFICATION_CONFIG_FILES=.env.notification-1,.env.notification-2
